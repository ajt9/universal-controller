[Unit]
Description=Universal Controller Web Server
After=network.target

[Service]
Type=simple

User=@PROJECT_USER@
Group=@PROJECT_USER@

WorkingDirectory=@PROJECT_DIR@/web

ExecStart=/bin/bash @PROJECT_DIR@/scripts/start-server.sh

Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
